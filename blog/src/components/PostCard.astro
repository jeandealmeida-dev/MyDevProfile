---
import { formatDate, type Lang } from '../i18n';
import { postUrl, readingTime, tagSlug, type Post } from '../posts';
import { t } from '../i18n';

interface Props {
  post: Post;
  lang: Lang;
}
const { post, lang } = Astro.props;
---
<article class="bento-card post-card">
  <div class="post-card-meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(lang, post.data.date)}</time>
    <span>·</span>
    <span>{readingTime(post)} {t(lang, 'post.readingTime')}</span>
  </div>
  <h2 class="post-card-title"><a href={postUrl(post)}>{post.data.title}</a></h2>
  <p class="post-card-desc">{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="tag-list">
      {post.data.tags.map((tag) => (
        <li><a class="tag-chip" href={`/${lang}/tags/${tagSlug(tag)}/`}>#{tag}</a></li>
      ))}
    </ul>
  )}
</article>
